# Firebase Web SDK (Firebase Console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Decart permanent API key (server-only; never prefix with NEXT_PUBLIC_)
DECART_API_KEY=

# Public HTTPS URL of the separately deployed Socket.IO service
NEXT_PUBLIC_SIGNALING_URL=http://localhost:4000

# Optional but recommended for WebRTC users behind restrictive NAT/firewalls
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Firebase Admin service account (server-only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Paystack secret key (server-only; use sk_test_... before switching to sk_live_...)
PAYSTACK_SECRET_KEY=

# Canonical browser origin used by server-side origin checks
APP_ORIGIN=https://savatar.vercel.app
